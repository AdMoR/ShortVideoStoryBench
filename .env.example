# Copy to .env and fill in what the arms you run actually need. Never commit .env.
#
# Loaded twice, from the same file: `veb` reads it on the host (python-dotenv),
# and `sandbox=docker` hands it to each agent container as --env-file. That is
# the point of keeping it a file — no secret has to be typed on a command line,
# pasted into a config, or exported by hand before every run.

# ── Where the generation infrastructure lives ────────────────────────────────
# The pi generator's model. Rendered into the container's models.json as the
# `gx10` provider; on the host that provider comes from ~/.pi/agent/models.json.
VEB_LLM_BASE_URL=http://gx10-cbc5:8081/v1

# The WanGP server hosting MiniMax H3, for video_backend=wangp.
WANGP_SERVER_URL=http://gx10-cbc5:8082
WANGP_API_KEY=

# gx10-cbc5 resolves only over IPv6 through the host's local resolver, which a
# container does not inherit. This is its Tailscale IPv4 — no DNS required.
VEB_GX10_IP=100.114.182.89

# ── Hosted model arms ────────────────────────────────────────────────────────
# model=openai_gpt56_luna, and judge=litellm's default backend.
OPENAI_API_KEY=

# model=anthropic_sonnet5. Note this is an API key and bills the API account;
# the host's ~/.pi/agent/auth.json subscription login is not mounted into the
# sandbox, deliberately — it is a refresh token the agent could read off disk.
ANTHROPIC_API_KEY=
