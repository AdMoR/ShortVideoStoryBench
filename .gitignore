# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/

# Test & tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Secrets ---
# Judge/model API keys are passed through config; never commit a filled-in env file.
.env
.env.*
!.env.example

# --- Benchmark output ---
# Every `veb` run writes a timestamped Hydra output dir under runs/ holding the
# generated .mp4s, report.json/html and .hydra/ snapshot. Large and reproducible.
runs/*
!runs/FINDINGS.md

# Stray generated media outside a run dir
*.mp4
*.webm
