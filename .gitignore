# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/

# Test & tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store

# --- Secrets ---
# Judge/model API keys are passed through config; never commit a filled-in env file.
.env
.env.*
!.env.example

# --- Benchmark output ---
# Every `veb` run writes a timestamped Hydra output dir under runs/ holding the
# generated .mp4s, report.json/html and .hydra/ snapshot. Large and reproducible.
runs/*
!runs/FINDINGS.md

# Stray generated media outside a run dir
*.mp4
*.webm

# make(1) build stamps
.make/

# Seed builder work directories: records, the index, the build report. Not hidden —
# the report is meant to be opened and read, and a dot-directory hides the main
# output of the build from the person who asked for it. Ignored because it is
# regenerable and a full build is hundreds of MB of digests.
seedbuild*/

# Generated datasets. `dataset/` is the curated one and is committed; these are
# rebuilt by `veb-seedbuild` and would otherwise land as thousands of lines of diff.
dataset_finevideo*/

# `make atlas` / `make site` output — renderings of what is already in the repo.
# site/data/runs.json is NOT ignored: it is the published run snapshot.
out/
_site/
